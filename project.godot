; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="omega"
config/version="0.1"
run/main_scene="uid://xi7n0k01blu7"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://Assets_LICENSED/icon.svg"

[audio]

buses/default_bus_layout="res://other/default_bus_layout.tres"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
GlobalInventoryHandler="*res://Code/Inventory/global_inventory_handler.gd"
GlobalJournalHandler="*res://Code/Journal/global_journal_handler.gd"
GlobalEventBus="*res://Code/Other/CombatSample/global_event_bus.gd"
GlobalGameData="*uid://dbry0tf860fil"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0

[dialogic]

directories/dch_directory={
"dinkum": "res://Dialogue/Characters/dinkum.dch",
"donut": "res://Dialogue/Characters/donut.dch",
"narrator": "res://Dialogue/Characters/narrator.dch",
"ptg": "res://Dialogue/Characters/ptg.dch",
"robert": "res://Dialogue/Characters/robert.dch"
}
directories/dtl_directory={
"donuts_test": "res://Dialogue/Timelines/donuts_test.dtl",
"robert_test_timeline": "res://Dialogue/Timelines/robert_test_timeline.dtl",
"timeline_intro-cutscene": "res://Dialogue/Timelines/timeline_intro-cutscene.dtl"
}
variables={}
glossary/default_case_sensitive=true
layout/style_list=["res://Dialogue/myStyle3.tres", "res://Dialogue/dialogic-style_no_portrait.tres", "res://Dialogue/style_cutscene-centered-text.tres"]
layout/default_style="res://Dialogue/dialogic-style_no_portrait.tres"
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
save/autosave_delay=60.0
save/encryption_on_exports_only=true
audio/max_channels=4.0
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
text/autopauses={}
portraits/default_portrait=""

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[gui]

theme/custom_font="uid://b7oqoud6rsq4t"

