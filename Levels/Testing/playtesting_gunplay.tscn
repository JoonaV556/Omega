[connection signal="body_entered" from="End Trigger" to="Systems/Killhouse Manager" method="on_player_reached_exit"]
[connection signal="killhouse_completed" from="Systems/Killhouse Manager" to="Layer - UI/UI Manager" method="on_completed"]
[connection signal="killhouse_completed" from="Systems/Killhouse Manager" to="Systems/Killhouse Timer" method="stop_timer"]
[connection signal="killhouse_started" from="Systems/Killhouse Manager" to="Systems/Killhouse Timer" method="start_timer"]
[connection signal="on_reset" from="Systems/Killhouse Manager" to="Layer - UI/UI Manager" method="on_restart"]
[connection signal="on_reset" from="Systems/Killhouse Manager" to="Systems/Killhouse Timer" method="reset"]
[connection signal="stopped" from="Systems/Killhouse Timer" to="Systems/Score Tracker" method="on_timer_stopped"]
[connection signal="started_moving" from="Systems/Character Movement Detector" to="Systems/Killhouse Manager" method="start_round"]
[connection signal="on_hi_score_updated" from="Systems/Score Tracker" to="Layer - UI/UI Manager" method="on_score_updated"]

